# ==============================================================================
# TurboVault Environment Variables
# ==============================================================================
#
# Copy this file to .env and customize for your environment.
# (.env files are loaded automatically if present.)
#
# Usage:
#   cp .env.example .env
#   $EDITOR .env
#   source .env
#   turbovault
#
# Only the variables documented here are read by the `turbovault` binary
# today. Anything else you see in older versions of this file was
# aspirational and has been removed.
# ==============================================================================

# ------------------------------------------------------------------------------
# VAULT CONFIGURATION
# ------------------------------------------------------------------------------

# Path to the Obsidian vault to register as the "default" vault at startup.
# Equivalent to `turbovault --vault <path>`.
# Both `~` and `$HOME`-style references are shell-expanded.
# OBSIDIAN_VAULT_PATH=~/Documents/ObsidianVault

# ------------------------------------------------------------------------------
# CONFIGURATION FILE
# ------------------------------------------------------------------------------

# Path to the YAML config (see config.example.yaml). Equivalent to
# `turbovault --config <path>`. Both `~` and `$HOME` are shell-expanded.
# Holds the `vaults:` block (multiple vault configs) and the
# `tool_visibility:` block (tool allowlist/hidden/disabled).
# TURBOVAULT_CONFIG=~/.config/turbovault/config.yaml

# ------------------------------------------------------------------------------
# TOOL VISIBILITY (overrides config-file `tool_visibility:`)
# ------------------------------------------------------------------------------

# Comma-separated tool names — if set, ONLY these tools are listed/callable.
# TURBOVAULT_ALLOWED_TOOLS=read_note,write_note,edit_note,search

# Comma-separated tool names — hidden from tools/list but still callable by name.
# TURBOVAULT_HIDDEN_TOOLS=full_health_analysis

# Comma-separated tool names — removed from tools/list AND rejected on direct call.
# TURBOVAULT_DISABLED_TOOLS=delete_note

# Hide every tool not annotated as read-only by TurboMCP. Boolean.
# TURBOVAULT_REQUIRE_READ_ONLY_TOOLS=1

# ------------------------------------------------------------------------------
# OPTIONAL DENSE RETRIEVAL AND RERANKING
# ------------------------------------------------------------------------------

# Inference stays external to TurboVault. These endpoints may be local or
# hosted; leaving the local defaults unchanged does not enable cloud inference.
# The initial dense index is built only when `reindex_embeddings` is called.
#
# Local example (the built-in endpoint/model defaults):
# TURBOVAULT_EMBEDDING_ENDPOINT=http://127.0.0.1:8082/v1/embeddings
# TURBOVAULT_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B-GGUF
# TURBOVAULT_RERANKER_ENDPOINT=http://127.0.0.1:8083/v1/rerank
# TURBOVAULT_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
#
# Optional OpenRouter example. Hosted inference sends Markdown chunks, enabled
# attachment text, queries, and reranking candidates to OpenRouter and its routed
# providers. Keep real keys only in an uncommitted .env or the MCP client's local
# environment.
# TURBOVAULT_EMBEDDING_ENDPOINT=https://openrouter.ai/api/v1/embeddings
# TURBOVAULT_EMBEDDING_MODEL=openai/text-embedding-3-small
# TURBOVAULT_EMBEDDING_API_KEY=sk-or-v1-...
# TURBOVAULT_RERANKER_ENDPOINT=https://openrouter.ai/api/v1/rerank
# TURBOVAULT_RERANKER_MODEL=cohere/rerank-v3.5
# TURBOVAULT_RERANKER_ENABLED=true
#
# A dedicated key overrides the embedding key for reranking. If unset, the
# embedding key is reused so one provider can serve both endpoints.
# TURBOVAULT_RERANKER_API_KEY=...
# TURBOVAULT_RERANKER_BATCH_SIZE=12
#
# Disable reranking while retaining BM25 + dense retrieval:
# TURBOVAULT_RERANKER_ENABLED=false
#
# Derived index and refresh controls:
# TURBOVAULT_EMBEDDING_INDEX_DIR=/path/to/cache
# TURBOVAULT_EMBEDDING_CHUNK_CHARS=2400
# TURBOVAULT_EMBEDDING_CHUNK_OVERLAP=200
# TURBOVAULT_EMBEDDING_BATCH_SIZE=16
# TURBOVAULT_EMBEDDING_REFRESH_AFTER_SECS=21600
#
# Optional local extraction of text-layer PDFs and DOCX attachments into the
# dense index. Disabled by default. Scanned PDFs need OCR and are skipped; legacy
# .doc files are unsupported. The byte limit defaults to 50 MiB per file.
# TURBOVAULT_DOCUMENT_INDEXING_ENABLED=true
# TURBOVAULT_DOCUMENT_MAX_BYTES=52428800

# ------------------------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------------------------

# env_logger-style filter string — same syntax `cargo run -- --help` documents
# for many Rust binaries (turbovault-foy lifted this from README claim to
# actual behavior).
#
# Priority:
#   RUST_LOG (this var)  ->  --profile production default  ->  --profile development default
#
# Examples:
# RUST_LOG=debug
# RUST_LOG=info,turbo_vault=debug
# RUST_LOG=warn,turbo_vault=trace,turbomcp=debug

# ==============================================================================
# Precedence (highest -> lowest):
#   1. CLI flags (--vault, --config, --allowed-tools, ...)
#   2. Environment variables (this file)
#   3. `--config` YAML file's `tool_visibility:` block
#   4. Built-in defaults
# ==============================================================================
